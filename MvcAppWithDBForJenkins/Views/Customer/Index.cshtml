 
@{
    List<TblCustomer> lst = (List<TblCustomer>)ViewData["customers"];
    int i = 1;
}
<div class="row">
    <div class="col-md-4">
       
    </div>
    <div class="col-md-8">
        <table class="table">
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Customer Name</th>
                    <th>Email Address</th>
                    <th>Mobile number</th>
                    <th>City</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lst)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.CustomerName</td>
                        <td>@item.EmailAddress</td>
                        <td>@item.MobileNumber</td>
                        <td>@item.City</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>