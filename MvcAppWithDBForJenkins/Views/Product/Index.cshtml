@model TblProduct
@{
    List<TblProduct> lst = (List<TblProduct>)ViewData["products"];
    int i = 1;
}
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm())
        {
        <div class="card">
            <div class="card-header">
                <h4>Product Form</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Product Name</label>
                        @Html.TextBoxFor(e=>e.ProductName,new { @class="form-control"})
                    </div>
                <div class="mb-3">
                    <label>Product Rate</label>
                        @Html.TextBoxFor(e=>e.Rate,new { @class="form-control"})
                    </div>
                    <div class="mb-3">
                        <label>Gst</label>
                        @Html.TextBoxFor(e => e.Gst, new { @class = "form-control" })
                    </div>
                    <div class="mb-3">
                        <label>Stock Quantity</label>
                        @Html.TextBoxFor(e => e.StockQuantity, new { @class = "form-control" })
                    </div>

            </div>
            <div class="card-footer">
                <input type="submit" value="Submit" class="btn btn-primary" />
                <h4 class="text-success">@ViewBag.msg</h4>
            </div>
        </div>    
        
        }
    </div>
    <div class="col-md-8">
        <table class="table">
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Product Name</th>
                    <th>Rate</th>
                    <th>Gst</th>
                    <th>Stock Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in lst)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.ProductName</td>
                        <td>@item.Rate</td>
                        <td>@item.Gst</td>
                        <td>@item.StockQuantity</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>